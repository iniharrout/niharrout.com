# Google Gemini API Key for AI Chat Widget
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Chat incoming-webhook URL. /api/lead posts every enquiry form here (location pages,
# homepage, /services/ pages and the b2b page). Set it in the host's environment variables.
LEAD_WEBHOOK_URL=your_google_chat_webhook_url_here
